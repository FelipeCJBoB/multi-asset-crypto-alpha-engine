# Ambiente — gerido por uv, nunca versionado
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Segredos — nunca no repo (B31)
.env
.env.*
*.pem
*.key

# Data lake — grande demais para git, reconstrutível por download determinístico
# (git não permite re-incluir arquivo dentro de diretório ignorado; por isso data/*, não data/)
data/*
!data/.gitkeep

# Exceção: quality_report.json é pequeno, legível por humano, e é o registro
# formal do Gate 1 (§1.3) — evidência de auditoria, não dado bruto. Fica junto
# de audit/ no que é versionado.
!data/quality_reports/
!data/quality_reports/*.json

# Artefatos de modelo e experimento — versionados por outro mecanismo (registry), não git
models/*.bin
models/*.json
experiments/*.parquet

# Locks de OS / editor
.DS_Store
Thumbs.db
*.swp
