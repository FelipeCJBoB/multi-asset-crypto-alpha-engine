# Ambiente — gerido por uv, nunca versionado
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Segredos — nunca no repo (B31)
.env
.env.*
*.pem
*.key

# Data lake — grande demais para git, reconstrutível por download determinístico
# (git não permite re-incluir arquivo dentro de diretório ignorado; por isso data/*, não data/)
data/*
!data/.gitkeep

# Exceção: quality_report.json é pequeno, legível por humano, e é o registro
# formal do Gate 1 (§1.3) — evidência de auditoria, não dado bruto. Fica junto
# de audit/ no que é versionado.
!data/quality_reports/
!data/quality_reports/*.json

# Mesma categoria/motivo de data/quality_reports/ acima — leakage_report.json
# (§11.5, Gate 2) é evidência de auditoria pequena e legível, não dado bruto.
!data/validation_reports/

# Mesma categoria/motivo de data/quality_reports/ acima — registro append-only
# PEQUENO de rodadas reais de produção (Label Engine / Fill Simulator), lido de
# volta pelo próprio pipeline — não é dado bruto reconstrutível, é log de
# execução. Corrigido 2026-08-22: morava em experiments/, nome incompatível
# com log de produção (`src/labels/experiment_log.py`,
# `src/execution/fill_simulator.py`).
!data/label_engine_runs/
!data/label_engine_runs/*.parquet
!data/execution_runs/
!data/execution_runs/*.parquet
!data/validation_reports/*.json

# Saída em massa de pipeline — reconstrutível a partir de código+config+dado
# fonte (config_hash amarra a versão exata, §3.4 B15). Mesma lógica de data/.
# Ancorado na raiz (/) de propósito — sem a barra inicial, "regime/" também
# bateria em src/regime/ (código-fonte!) e "labels/" em qualquer subpasta
# futura chamada labels. Já pegou esse bug uma vez nesta sessão.
/labels/
/regime/
/predictions/
/backtests/
/execution/

# Artefatos de modelo — versionados por outro mecanismo (registry), não git
models/*.bin
models/*.json

# Estas duas regras só batem em arquivos DIRETOS em models/ (ex.
# models/alpha_c1_v1.bin) — NÃO alcançam models/{model_id}/diagnostics/*.json
# (confirmado com `git check-ignore -v` contra esse path exato). Isso é
# intencional, não uma lacuna: os diagnósticos por fold x lado escritos por
# `src.models.pipeline.write_fold_diagnostics_atomic` são evidência de
# auditoria pequena e legível (gain_by_column, HHI, n_trees, tamanho de
# amostra), mesma categoria de data/quality_reports/ e experiments/ acima —
# não o artefato binário de modelo que as duas regras acima existem para
# excluir. Fica versionado.

# experiments/ NÃO está na lista acima de propósito: é pequeno (append-only
# de config+hash+timestamp, não dado bruto) e é o que torna o N do DSR
# reconstruível (§11.6) — mesma categoria de data/quality_reports/, versiona.

# Locks de OS / editor
.DS_Store
Thumbs.db
*.swp
